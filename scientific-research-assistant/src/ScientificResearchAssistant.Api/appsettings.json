{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Materials": {
        "RootDir": "materials",
        "MaxFiles": 200,
        "MaxFileChars": 200000,
        "MaxContextChars": 18000,
        "MaxPerDocChars": 6000,
        "AllowWrite": false,
        "WriteDir": "notes",
        "MaxWriteChars": 200000
    },
    "Python": {
        "Enabled": false,
        "TimeoutMs": 15000,
        "MaxOutputChars": 8000
    },
    "MCP": {
        "Type": "Http",
        "HttpUrl": "https://mcp.k-dense.ai/claude-scientific-skills/mcp",
        "DockerImage": "ghcr.io/k-dense-ai/claude-scientific-skills:latest",
        "RequestTimeoutMs": 300000
    }
}