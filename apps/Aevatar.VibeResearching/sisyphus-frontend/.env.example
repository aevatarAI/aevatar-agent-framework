# ============================================================
#  Sisyphus Frontend - Environment Variables
# ============================================================
#
#  Copy this file to .env.local for local development.
#  NEVER commit .env.local to version control!
#
# ============================================================

# ------------------------------------------------------------
#  API Configuration
# ------------------------------------------------------------
# Backend API URL (leave empty to use Vite proxy in development)
VITE_API_BASE_URL=

# ------------------------------------------------------------
#  Authentication Mode
# ------------------------------------------------------------
# 'cookie' (default) - Uses /api/auth/login with session cookies
# 'token' - Uses OpenIddict /connect/token (requires client config)
VITE_AUTH_MODE=cookie

# OpenIddict Client (only needed for token mode)
# VITE_ABP_CLIENT_ID=VibeResearching_React

# Enable mock auth for offline development (no backend needed)
VITE_MOCK_AUTH=false

# ------------------------------------------------------------
#  OAuth (disabled by default)
# ------------------------------------------------------------
VITE_ENABLE_OAUTH=false

# Uncomment and configure if enabling OAuth:
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GITHUB_CLIENT_ID=your-github-client-id
