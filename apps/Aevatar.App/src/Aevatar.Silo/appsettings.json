{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Information",
      "Orleans.Runtime": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "Orleans": "mongodb://localhost:27017/AevatarBusiness"
  },
  
  "AgentRuntime": {
    "RuntimeType": "Orleans",
  "Orleans": {
    "ClusterId": "aevatar-cluster",
    "ServiceId": "aevatar-service",
    "SiloPort": 11111,
    "GatewayPort": 30000
    }
  },
  
  "Storage": {
    "Provider": "MongoDB",
    "DatabaseName": "AevatarBusiness"
  },

  "MessageStream": {
    "Provider": "MassTransit"
  },
  "MassTransit": {
    "Stream": {
      "TopicPrefix": "agent-events",
      "TransportType": "Kafka",
      "RuntimeName": "Orleans",
      "TopicMapping": {
        "GodChat": "godgpt-chat-responses"
      },
      "Consumer": {
        "Enabled": true,
        "DispatchHandler": "GrainHandler",
        "IncludeTopicPrefix": true,
        "AutoScanAgentTopics": true
      },
      "CQRS": {
        "Enabled": true,
        "MessageTtlSeconds": 3600,
        "EnableDeduplication": true
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "ConsumerGroupId": "aevatar-agents-group"
      }
    }
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  
  "EventSourcing": {
    "Enabled": true,
    "SnapshotFrequency": 1,
    "Provider": "MongoDB"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state",
    "Username": "",
    "Password": ""
  },
  
  "CQRS": {
    "Projector": {
      "BatchSize": 50,
      "MaxBatchSize": 200,
      "FlushIntervalMs": 1000,
      "MaxRetryCount": 3
    }
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Orleans": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/silo-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}

