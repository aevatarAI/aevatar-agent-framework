        <ProjectReference Include="../../modules/Comments/MongoDB/Aevatar.VibeResearching.Comments.MongoDB.csproj" />
        <ProjectReference Include="../../modules/Infrastructure/MongoDB/Aevatar.VibeResearching.Infrastructure.MongoDB.csproj" />
        <ProjectReference Include="../../modules/UserProviders/MongoDB/Aevatar.VibeResearching.UserProviders.MongoDB.csproj" />
        <ProjectReference Include="../../modules/UserProviders/Infrastructure/Aevatar.VibeResearching.UserProviders.Infrastructure.csproj" />

        <!-- Agent Framework (host needs direct access for configuration) -->
