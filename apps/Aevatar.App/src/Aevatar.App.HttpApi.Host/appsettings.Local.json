{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Aevatar": "Debug"
    }
  },
  
  "AgentRuntime": {
    "RuntimeType": "Local"
  },
  "MessageStream": {
    "Provider": "MassTransit"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state"
  },
  
  "CQRS": {
    "UseBatching": true,
    "BatchSize": 10,
    "BatchTimeoutSeconds": 1
  }
}

