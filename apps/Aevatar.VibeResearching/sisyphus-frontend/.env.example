# ============================================================
# Sisyphus Frontend Environment Variables
# Copy this file to .env.local or .env.production
# ============================================================

# Backend API Base URL (for Axiom reasoning service)
# Development: leave empty to use proxy
# Production: set to actual API domain, e.g., https://api.sisyphus.example.com
VITE_AXIOM_API_BASE=

# Backend port for local development proxy
BACKEND_PORT=5678

# Frontend dev server port
PORT=5173
