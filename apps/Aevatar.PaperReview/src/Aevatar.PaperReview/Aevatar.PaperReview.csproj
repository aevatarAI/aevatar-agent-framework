<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aevatar.PaperReview</RootNamespace>
    <DisableReferencedProjectStaticWebAssets>true</DisableReferencedProjectStaticWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cognitive framework -->
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Cognitive.Core\Aevatar.Agents.Cognitive.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Cognitive.Content\Aevatar.Agents.Cognitive.Content.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.CognitiveMesh.Dsl\Aevatar.CognitiveMesh.Dsl.csproj" />

    <!-- Agent Framework 核心 -->
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Runtime.Local\Aevatar.Agents.Runtime.Local.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.AI.MEAI\Aevatar.Agents.AI.MEAI.csproj" />
    <ProjectReference Include="..\..\..\..\plugins\Aevatar.Agents.Plugins.MassTransit\Aevatar.Agents.Plugins.MassTransit.csproj" />

    <!-- Cognitive DSL 系统 -->
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Cognitive\Aevatar.Agents.Cognitive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supabase -->
    <PackageReference Include="Supabase" />
    <!-- PDF text extraction -->
    <PackageReference Include="UglyToad.PdfPig" />
    <!-- Template engine -->
    <PackageReference Include="Scriban" />
    <!-- YAML parsing for Prompty -->
    <PackageReference Include="YamlDotNet" />
    
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    
    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prompt Templates -->
    <Content Include="prompts\*.scriban">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="prompts\*.prompty">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\src\Aevatar.Agents.Cognitive\workflows\maker.yaml">
      <Link>workflows\maker.yaml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\apps\Aevatar.CognitiveMesh\src\Aevatar.CognitiveMesh\projects\paper-review.yaml">
      <Link>projects\paper-review.yaml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
