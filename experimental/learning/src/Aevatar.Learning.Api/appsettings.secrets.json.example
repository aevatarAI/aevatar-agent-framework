{
  "LLMProviders": {
    "Default": "deepseek",
    "Providers": {
      "deepseek": {
        "Name": "deepseek",
        "ProviderType": "OpenAI",
        "ApiKey": "${DEEPSEEK_API_KEY}",
        "Endpoint": "https://YOUR_OPENAI_COMPAT_ENDPOINT",
        "Model": "deepseek-chat",
        "Temperature": 0.2,
        "MaxTokens": 1200,
        "TimeoutMilliseconds": 900000
      }
    }
  }
}


