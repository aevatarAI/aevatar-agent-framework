{
  "Aevatar.Workshop": {
    "SystemPrompt": "You are a helpful assistant. Keep answers concise.",
    "Temperature": 0.6,
    "MaxOutputTokens": 1200,
    "StreamChunkEveryN": 1,
    "MaxSnapshotMessages": 60,
    "AgentRole": "workshop_default",
    "EnableAgentYaml": true,
    "WorkflowName": "workshop_mesh",
    "EnableWorkflowYaml": true,
    "DotNetToolDirectories": [
      "~/.aevatar/tools/dotnet",
      "~/.aevatar/dotnet-tools",
      "apps/Aevatar.Trading/src/Aevatar.Trade/Tools/DotNetSkills"
    ],
    "DotNetToolMaxFiles": 80,
    "SqliteConnection": "Data Source=workshop-demo.db"
  },
  "Aevatar": {
    "AiTools": {
      "File": {
        "ReadRoots": [
          "~/.aevatar/agents"
        ],
        "WriteRoots": [
          "~/.aevatar/agents"
        ],
        "WriteExtensions": [
          ".yaml",
          ".yml"
        ]
      }
    }
  }
}
