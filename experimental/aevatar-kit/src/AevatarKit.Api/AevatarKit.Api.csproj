<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AevatarKit.Core\AevatarKit.Core.csproj" />
    <ProjectReference Include="..\AevatarKit.Runtime\AevatarKit.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serve frontend files from experimental/aevatar-kit/frontend as wwwroot -->
    <Content Include="..\..\frontend\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>


