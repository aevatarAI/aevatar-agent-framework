{
  "AgentRuntime": {
    "RuntimeType": "Local",
    "Orleans": {
      "ClusterId": "trade-cluster",
      "ServiceId": "trade-service",
      "UseLocalhostClustering": true,
      "SiloPort": 11111,
      "GatewayPort": 30000
    }
  },

  "Exchange": {
    "ExchangeType": "WEEX",
    "Mode": "Contract",
    "Symbols": ["cmt_btcusdt"],
    "EnableWebsocket": true,
    "EnableRestPolling": true,
    "CredentialsKey": "weex"
  },

  "ExchangeCredentials": {
    "weex": {
      "Endpoint": "https://api-contract.weex.com",
      "ApiKey": "",
      "ApiSecret": "",
      "Passphrase": ""
    },
    "okx": {
      "Endpoint": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Passphrase": ""
    }
  },

  "Policy": {
    "Trading": {
      "Symbol": "cmt_btcusdt",
      "Interval": "1m",
      "ExecutionMode": "Live",
      "MinBaseAssetUsdOnStart": 0,
      "MaxPositionPct": 10,
      "MaxTotalPositionPct": 30,
      "MaxLossPerTrade": 2,
      "MaxDailyLoss": 5,
      "MinConfidenceToTrade": 60
    },
    "Analysis": {
      "SentimentWeight": 0.3,
      "TechnicalWeight": 0.4,
      "NewsWeight": 0.3
    },
    "Risk": {
      "MaxConsecutiveLosses": 3,
      "CooldownMinutes": 60,
      "StopLossPct": 2,
      "TakeProfitPct": 4
    },
    "Trigger": {
      "PriceChangePct": 0.5,
      "PriceChangeAbs": 0,
      "WindowSeconds": 30,
      "CooldownSeconds": 30,
      "TriggerOnStartup": true
    }
  },
  
  "TradeAudit": {
    "Enabled": true,
    "OutputDir": "trade-audit",
    "IncludeMarketData": false,
    "RequestAiwarsUpload": true
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Aevatar.Trade": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
