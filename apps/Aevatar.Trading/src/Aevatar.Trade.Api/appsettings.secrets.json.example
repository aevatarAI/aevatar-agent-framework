{
  "ExchangeCredentials": {
    "weex": {
      "Endpoint": "https://api-contract.weex.com",
      "ApiKey": "YOUR_WEEX_API_KEY",
      "ApiSecret": "YOUR_WEEX_API_SECRET",
      "Passphrase": "YOUR_WEEX_PASSPHRASE"
    },
    "okx": {
      "Endpoint": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Passphrase": ""
    }
  },

  "Weex": {
    "BaseUrl": "https://api-spot.weex.com",
    "MarketDataBaseUrl": "",
    "TradingBaseUrl": "",
    "PublicWebSocketUrl": "",
    "WebSocketOrigin": "https://www.weex.com"
  },

  "LLMProviders": {
    "default": "trade-default",
    "providers": {
      "trade-default": {
        "providerType": "OpenAI",
        "apiKey": "${OPENAI_API_KEY}",
        "model": "gpt-4o-mini",
        "temperature": 0.3,
        "maxTokens": 2000
      }
    }
  }
}
