{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "LLMProviders": {
    "Default": "claude_agent_sdk_full",
    "Providers": {
      "claude_agent_sdk_minimal": {
        "Name": "claude_agent_sdk_minimal",
        "ProviderType": "claude_agent_sdk",
        "Model": "demo-mock",
        "TimeoutMilliseconds": 60000,
        "ProviderSpecificSettings": {
          "runnerCommand": "node",
          "runnerArgs": [
            "__DEMO_BIN__/runner/mock_claude_agent_sdk_runner.mjs"
          ],
          "projectRoot": "__DEMO_BIN__/demo_project",
          "plugins": [
            "__DEMO_BIN__/plugins"
          ],
          "allowedTools": [],
          "permissionMode": "minimal",
          "timeoutMs": 60000,
          "maxOutputChars": 262144
        }
      },
      "claude_agent_sdk_full": {
        "Name": "claude_agent_sdk_full",
        "ProviderType": "claude_agent_sdk",
        "Model": "demo-mock",
        "TimeoutMilliseconds": 60000,
        "ProviderSpecificSettings": {
          "runnerCommand": "node",
          "runnerArgs": [
            "__DEMO_BIN__/runner/mock_claude_agent_sdk_runner.mjs"
          ],
          "projectRoot": "__DEMO_BIN__/demo_project",
          "plugins": [
            "__DEMO_BIN__/plugins"
          ],
          "allowedTools": [
            "filesystem_read",
            "filesystem_write"
          ],
          "permissionMode": "allowlist",
          "timeoutMs": 60000,
          "maxOutputChars": 262144
        }
      }
    }
  }
}


