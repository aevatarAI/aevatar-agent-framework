<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Aevatar.Silo</RootNamespace>
    <AssemblyName>Aevatar.Silo</AssemblyName>
  </PropertyGroup>

  <!-- All package versions managed by Directory.Packages.props -->
  <ItemGroup>
    <!-- Orleans Core -->
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Runtime" />
    <PackageReference Include="Microsoft.Orleans.Core" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Memory" />
    <PackageReference Include="Microsoft.Orleans.Serialization.Protobuf" />
    <PackageReference Include="Orleans.Providers.MongoDB" />
    <!-- Use custom Orleans.Streams.Kafka 9.3.0-net10.0 with Producer configuration support -->
    <PackageReference Include="Orleans.Streams.Kafka" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.AspNetCore" />
    
    <!-- Protobuf -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- Elasticsearch -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
  </ItemGroup>

  <!-- Protobuf Files -->
  <ItemGroup>
    <Protobuf Include="Protos\**\*.proto" GrpcServices="None" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <!-- Agent Framework (CRITICAL for Grain discovery) -->
    <ProjectReference Include="../../../../src/Aevatar.Agents.Abstractions/Aevatar.Agents.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.Core/Aevatar.Agents.Core.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.AI.Abstractions/Aevatar.Agents.AI.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.AI.MEAI/Aevatar.Agents.AI.MEAI.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.Runtime.Orleans/Aevatar.Agents.Runtime.Orleans.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.Persistence.MongoDB/Aevatar.Agents.Persistence.MongoDB.csproj" />
    <ProjectReference Include="../../../../src/Aevatar.Agents.Runtime.Orleans.MongoDB/Aevatar.Agents.Runtime.Orleans.MongoDB.csproj" />
    <ProjectReference Include="../../../../plugins/Aevatar.Agents.Plugins.MassTransit/Aevatar.Agents.Plugins.MassTransit.csproj" />
    <ProjectReference Include="../../../../plugins/Aevatar.Agents.Plugins.CQRS/Aevatar.Agents.Plugins.CQRS.csproj" />
    
    <!-- Business Server Projects -->
    <ProjectReference Include="..\Aevatar.App.Domain\Aevatar.App.Domain.csproj" />
    <ProjectReference Include="..\Aevatar.App.Application\Aevatar.App.Application.csproj" />
    <ProjectReference Include="..\Aevatar.App.Agents\Aevatar.App.Agents.csproj" />
    <ProjectReference Include="..\Aevatar.App.MongoDB\Aevatar.App.MongoDB.csproj" />
    <ProjectReference Include="..\Aevatar.App.HttpApi\Aevatar.App.HttpApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.Production.json" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="STATUS.md" />
  </ItemGroup>

</Project>

