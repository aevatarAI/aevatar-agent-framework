{
  "AgentRuntime": {
    "RuntimeType": "Local",
    "Orleans": {
      "ClusterId": "trade-cluster",
      "ServiceId": "trade-service",
      "UseLocalhostClustering": true,
      "SiloPort": 11111,
      "GatewayPort": 30000
    }
  },

  "Exchange": {
    "ExchangeType": "WEEX",
    "Mode": "Contract",
    "Symbols": ["cmt_btcusdt", "cmt_ethusdt", "cmt_ltcusdt", "cmt_solusdt", "cmt_bnbusdt", "cmt_xrpusdt", "cmt_adausdt", "cmt_dogeusdt"],
    "EnableWebsocket": false,
    "EnableRestPolling": true,
    "CredentialsKey": "weex"
  },

  "Policy": {
    "Trading": {
      "Symbol": "cmt_btcusdt",
      "Interval": "1m",
      "ExecutionMode": "Live",
      "MinBaseAssetUsdOnStart": 0,
      "MaxPositionPct": 5,
      "MaxTotalPositionPct": 20,
      "MaxLossPerTrade": 1.2,
      "MaxDailyLoss": 3,
      "MinConfidenceToTrade": 45
    },
    "Analysis": {
      "SentimentWeight": 0.3,
      "TechnicalWeight": 0.4,
      "NewsWeight": 0.3
    },
    "Risk": {
      "MaxConsecutiveLosses": 3,
      "CooldownMinutes": 10,
      "StopLossPct": 1.0,
      "TakeProfitPct": 1.2
    },
    "Trigger": {
      "PriceChangePct": 0.2,
      "PriceChangeAbs": 0,
      "WindowSeconds": 15,
      "CooldownSeconds": 10,
      "TriggerOnStartup": true
    }
  },
  
  "MarketChat": {
    "ChatIntervalSeconds": 300
  },

  "Startup": {
    "AutoStart": true,
    "AutoStartAllowLive": true
  },

  "TradeAudit": {
    "Enabled": true,
    "OutputDir": "trade-audit",
    "IncludeMarketData": false,
    "RequestAiwarsUpload": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Aevatar.Trade": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
