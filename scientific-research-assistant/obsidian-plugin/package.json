{
  "name": "aevatar-sra-obsidian-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Obsidian Desktop plugin for driving Scientific Research Assistant (SRA) via HTTP/SSE.",
  "scripts": {
    "build": "node esbuild.mjs && npm run build:css",
    "dev": "node esbuild.mjs --watch",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o styles.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o styles.css --watch",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@tailwindcss/typography": "0.5.19",
    "autoprefixer": "10.4.20",
    "esbuild": "0.20.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "@types/node": "22.10.2"
  }
}


