{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "InterruptibleChatWebDemo": {
    "SystemPrompt": "你是一个像 Cursor 一样的编程助手。回答要短、准、可执行；不知道就说不知道。",
    "Temperature": 0.4,
    "MaxOutputTokens": 800
  },
  "LLMProviders": {
    "default": "deepseek",
    "providers": {
      "deepseek": {
        "providerType": "OpenAI",
        "endpoint": "https://api.deepseek.com/v1",
        "model": "deepseek-chat",
        "enableStreaming": true
      }
    }
  }
}


