<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.2" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAspireHost>true</IsAspireHost>
        <RootNamespace>Aevatar.AppHost</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
    </ItemGroup>

    <!-- 
        Aevatar.App Distributed Services:
        1. Aevatar.Silo - Orleans Silo (Agent runtime)
        2. Aevatar.App.HttpApi.Host - HTTP API Service
        3. Aevatar.AuthServer - OpenIddict Auth Server
    -->
    <ItemGroup>
        <ProjectReference Include="..\Aevatar.App\src\Aevatar.Silo\Aevatar.Silo.csproj" />
        <ProjectReference Include="..\Aevatar.App\src\Aevatar.App.HttpApi.Host\Aevatar.App.HttpApi.Host.csproj" />
        <ProjectReference Include="..\Aevatar.App\src\Aevatar.AuthServer\Aevatar.AuthServer.csproj" />
    </ItemGroup>

</Project>

