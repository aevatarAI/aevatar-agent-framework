{
  "Trading": {
    "Symbol": "cmt_btcusdt",
    "Interval": "1m",
    "ExecutionMode": "DryRun",
    "MinBaseAssetUsdOnStart": 10,
    "MaxPositionPct": 10,
    "MaxTotalPositionPct": 30,
    "MaxLossPerTrade": 2,
    "MaxDailyLoss": 5,
    "MinConfidenceToTrade": 60
  },
  
  "Analysis": {
    "SentimentWeight": 0.3,
    "TechnicalWeight": 0.4,
    "NewsWeight": 0.3
  },
  
  "RiskControl": {
    "MaxConsecutiveLosses": 3,
    "CooldownMinutes": 60,
    "StopLossPct": 2,
    "TakeProfitPct": 4
  },
  
  "TradeAudit": {
    "Enabled": true,
    "OutputDir": "trade-audit",
    "IncludeMarketData": false,
    "RequestAiwarsUpload": false
  },
  
  "DecisionEngine": {
    "Mode": "Direct",
    "CognitiveMeshBaseUrl": "",
    "CognitiveMeshStrategy": "Cognitive",
    "CognitiveWorkflow": "maker-v2",
    "TimeoutSeconds": 300
  },
  
  "Weex": {
    "Mode": "Contract",
    "BaseUrl": "https://api-contract.weex.com",
    "ApiKey": "${WEEX_API_KEY}",
    "ApiSecret": "${WEEX_API_SECRET}",
    "Passphrase": "${WEEX_PASSPHRASE}"
  },
  
  "LLM": {
    "Provider": "OpenAI",
    "Model": "gpt-4",
    "ApiKey": "${OPENAI_API_KEY}",
    "Temperature": 0.3,
    "MaxTokens": 2000
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Aevatar.Trade": "Debug",
      "Microsoft": "Warning"
    }
  }
}
