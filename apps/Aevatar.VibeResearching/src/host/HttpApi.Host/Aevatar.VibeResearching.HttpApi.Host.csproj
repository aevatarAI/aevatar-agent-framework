        <PackageReference Include="Volo.Abp.BlobStoring.Database.MongoDB" />

        <!-- Audit Logging -->
        <PackageReference Include="Volo.Abp.AuditLogging.Domain" />
        <PackageReference Include="Volo.Abp.AuditLogging.MongoDB" />

        <!-- Other packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <None Include="skillpacks.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="workflows/*.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Aevatar.VibeResearching.Api.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
