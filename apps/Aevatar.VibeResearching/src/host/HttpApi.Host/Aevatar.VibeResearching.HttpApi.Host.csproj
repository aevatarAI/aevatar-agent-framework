        <ProjectReference Include="../../modules/Agents/Application/Aevatar.VibeResearching.Agents.Application.csproj" />
        <ProjectReference Include="../../modules/Comments/Application/Aevatar.VibeResearching.Comments.Application.csproj" />
        <ProjectReference Include="../../modules/Infrastructure/Application/Aevatar.VibeResearching.Infrastructure.Application.csproj" />
        <ProjectReference Include="../../modules/UserProviders/Application/Aevatar.VibeResearching.UserProviders.Application.csproj" />

        <!-- Module Data Access layers -->
        <ProjectReference Include="../../modules/Sessions/MongoDB/Aevatar.VibeResearching.Sessions.MongoDB.csproj" />
        <ProjectReference Include="../../modules/Knowledge/Neo4j/Aevatar.VibeResearching.Knowledge.Neo4j.csproj" />
