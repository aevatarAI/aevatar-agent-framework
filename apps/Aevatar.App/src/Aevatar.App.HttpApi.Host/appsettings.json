{
  "App": {
    "SelfUrl": "http://localhost:8082",
    "CorsOrigins": "http://localhost:8001,http://localhost:8082,https://localhost:44320,https://localhost:44345"
  },
  "AwsS3": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "ap-northeast-1",
    "ContainerName": "godgpt-backend-staging"
  },
  "GodGPT": {
    "Version": "1.0.0",
    "Features": {
      "VoiceFeature": true,
      "ImageUpload": true,
      "ShareFeature": true
    }
  },
  "ConnectionStrings": {
    "Default": "mongodb://localhost:27017/AevatarBusiness",
    "Orleans": "mongodb://localhost:27017/AevatarBusiness"
  },
  "AuthServer": {
    "Authority": "http://localhost:8001/",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "App_Swagger"
  },
  "StringEncryption": {
    "DefaultPassPhrase": ""
  },
  "AgentRuntime": {
    "RuntimeType": "Orleans",
    "Orleans": {
      "ClusterId": "aevatar-cluster",
      "ServiceId": "aevatar-service"
    }
  },
  "MessageStream": {
    "Provider": "MassTransit"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Debug",
      "Aevatar": "Debug"
    }
  },
  "MassTransit": {
    "Stream": {
      "TopicPrefix": "agent-events",
      "TransportType": "Kafka",
      "RuntimeName": "HttpApi",
      "TopicMapping": {
        "GodChat": "godgpt-chat-responses"
      },
      "Producer": {
        "Enabled": true
      },
      "Consumer": {
        "Enabled": true,
        "DispatchHandler": "LocalHandler",
        "Topics": [
          "godgpt-chat-responses"
        ],
        "IncludeTopicPrefix": false,
        "AutoScanAgentTopics": false
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "ConsumerGroupId": "godgpt-chat-consumers"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state"
  }
}
