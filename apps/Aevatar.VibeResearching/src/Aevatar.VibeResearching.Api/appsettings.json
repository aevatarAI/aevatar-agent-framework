{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Pivot": {
        "ConfidenceThreshold": 0.7,
        "ClarificationThreshold": 0.6,
        "RollbackWindowMinutes": 30,
        "SubagentAckTimeoutSeconds": 3,
        "MaxQueueDepth": 5,
        "SemanticSimilarityThreshold": 0.7
    },
    "Materials": {
        "MaxFiles": 200,
        "MaxFileChars": 200000,
        "MaxContextChars": 18000,
        "MaxPerDocChars": 6000,
        "AllowWrite": true,
        "MaxWriteChars": 200000
    },
    "MongoDB": {
        "ConnectionString": "",
        "Database": "aevatar"
    },
    "SQLite": {
        "Enabled": true
    },
    "Python": {
        "Enabled": true,
        "TimeoutMs": 15000,
        "MaxOutputChars": 8000
    },
    "Vibe": {
        "DagConsensus": {
            "Mode": "maker",
            "VerifierCount": 3,
            "Quorum": 2,
            "AnyRedFlagBlocks": true,
            "PerVerifierTimeoutMs": 25000
        },
        "MeshOrchestration": {
            "Enabled": true,
            "OnCompileError": "fallback"
        }
    },
    "ReviewAgent": {
        "IterationIntervalMinutes": 30,
        "OutOfDateThresholdMinutes": 60,
        "ToDeleteThresholdMinutes": 1440,
        "LLMProviderName": "deepseek-deepseek-chat",
        "PerNodeTimeoutSeconds": 120
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "http://localhost:5173",
            "https://sisyphus.aelf.dev"
        ]
    }
}
