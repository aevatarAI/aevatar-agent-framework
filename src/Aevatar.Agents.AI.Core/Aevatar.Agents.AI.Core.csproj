<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Authors>Aevatar Team</Authors>
        <Description>AI capabilities for Aevatar Agent Framework</Description>
        <PackageProjectUrl>https://github.com/aevatar/agent-framework</PackageProjectUrl>
        <RepositoryUrl>https://github.com/aevatar/agent-framework</RepositoryUrl>
        <PackageTags>agents;ai;llm;semantic-kernel;autogen;distributed</PackageTags>
        <Version>1.0.0-alpha</Version>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Aevatar.Agents.AI.Abstractions\Aevatar.Agents.AI.Abstractions.csproj" />
        <ProjectReference Include="..\Aevatar.Agents.Core\Aevatar.Agents.Core.csproj" />
        <ProjectReference Include="..\Aevatar.Agents.Abstractions\Aevatar.Agents.Abstractions.csproj" />
        <ProjectReference Include="..\Aevatar.Agents.AGUI\Aevatar.Agents.AGUI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- AI Provider Abstractions -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.Http" />

        <!-- Protobuf Dynamic Message Creation -->
        <PackageReference Include="Google.Protobuf" />
        <!-- MCP (Model Context Protocol) tool integration -->
        <PackageReference Include="ModelContextProtocol.Core" />
        <!-- YAML parsing for agent configuration -->
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="ai_messages.proto" GrpcServices="None" />
        <Protobuf Include="Messages\ai_events.proto" GrpcServices="None" />
        <Protobuf Include="Messages\agentic_rag_messages.proto"
                  GrpcServices="None"
                  AdditionalImportDirs="..\Aevatar.Agents.Abstractions" />
        <Protobuf Include="Tool\tool_messages.proto" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The SDK does NOT automatically exclude nested bin/obj directories from default globs.
          Keep them excluded to avoid duplicate compilation (e.g., protobuf generated files under nested obj/).
        -->
        <Compile Remove="**\bin\**" />
        <Compile Remove="**\obj\**" />
        <None Remove="**\bin\**" />
        <None Remove="**\obj\**" />
        <EmbeddedResource Remove="**\bin\**" />
        <EmbeddedResource Remove="**\obj\**" />
    </ItemGroup>

</Project>