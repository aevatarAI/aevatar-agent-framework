{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5099"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Aevatar": {
    "Notebook": {
      "NotebookId": "default"
    },
    "Persistence": {
      "MemoryStore": "file",
      "MemoryVectorIndex": "file",
      "MemoryGraph": "file",
      "File": {
        "TraceRoot": "",
        "MemoryRoot": "",
        "VectorRoot": ""
      },
      "MongoDBMemory": {
        "MemoryEntriesCollection": "memory_entries",
        "MemoryVectorsCollection": "memory_vectors",
        "EnsureTextIndexOnContent": false
      },
      "SupabaseMemory": {
        "Schema": "aevatar_memory",
        "MemoryEntriesTable": "memory_entries",
        "MemoryVectorsTable": "memory_vectors",
        "VectorDimensions": 1536,
        "DistanceMetric": 0,
        "EnableFullTextSearch": false,
        "FtsRegConfig": "simple",
        "AutoCreateVectorExtension": false,
        "AutoCreateSchema": true,
        "AutoCreateTables": true,
        "AutoCreateIndexes": true,
        "LockDownPublicAccess": true,
        "EnableRowLevelSecurity": false,
        "ForceRowLevelSecurity": false,
        "CreateServiceRolePolicies": false
      },
      "Neo4j": {
        "Uri": "bolt://localhost:7687",
        "Username": "neo4j",
        "Password": "",
        "Database": "neo4j"
      }
    }
  },
  "LLMProviders": {
    "Default": "default",
    "Providers": {
      "default": {
        "Name": "default",
        "ProviderType": "OpenAI",
        "Model": "gpt-4o-mini",
        "EnableStreaming": true
      }
    }
  },
  "ConnectionStrings": {
    "MongoDB": "",
    "SupabasePostgres": ""
  },
  "MongoDB": {
    "Database": "aevatar"
  }
}


