{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.ClientModel": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "MassTransit": {
    "Stream": {
      "TransportType": "InMemory",
