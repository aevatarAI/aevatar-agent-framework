<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Aevatar.Trade</RootNamespace>
    </PropertyGroup>

    <!-- ============ Project References ============ -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.Abstractions\Aevatar.Agents.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.Core\Aevatar.Agents.Core.csproj" />
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.AI.Core\Aevatar.Agents.AI.Core.csproj" />
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.AI.Abstractions\Aevatar.Agents.AI.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.Runtime.Local\Aevatar.Agents.Runtime.Local.csproj" />
        <ProjectReference Include="..\..\..\src\Aevatar.Agents.Runtime.Orleans\Aevatar.Agents.Runtime.Orleans.csproj" />
    </ItemGroup>

    <!-- ============ Protobuf ============ -->
    <ItemGroup>
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="trade_messages.proto" />
    </ItemGroup>

    <!-- ============ NuGet Packages ============ -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Http" />
    </ItemGroup>
    
    <!-- ============ DotNet File Skills (Tooling) ============ -->
    <ItemGroup>
        <Compile Remove="Tools\DotNetSkills\**\*.cs" />
        <Content Include="Tools\DotNetSkills\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
